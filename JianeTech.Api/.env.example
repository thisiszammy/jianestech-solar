# =============================================================================
# Template for .env. Copy to JianeTech.Api/.env and fill in.
#
# The real .env lives HERE, beside Program.cs — not at the solution root. It is
# git-ignored; this file is committed and holds no secrets.
#
# Loaded by DotNetEnv (Env.TraversePath().Load()) at the top of Program.cs,
# before the host is built, so these arrive as ordinary environment variables
# and "__" is read as the ":" of a configuration path. TraversePath walks up
# from the working directory, which is this folder under `dotnet run` and the
# bin output under a built exe — either way it lands here.
#
# A key left blank falls back to appsettings.json. A key set to an empty value
# does NOT: it overrides the working default with nothing. That distinction
# matters most for ConnectionStrings__DefaultConnection and Jwt__Key, where an
# empty value stops the app starting rather than deferring to appsettings.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Database-first: this schema is not managed from code and there are no
# migrations. appsettings.json carries a working local default.
ConnectionStrings__DefaultConnection=

# -----------------------------------------------------------------------------
# JWT — access and refresh token minting
# -----------------------------------------------------------------------------
# Jwt__Key must be at least 32 bytes (256 bits); the app refuses to start on a
# shorter secret rather than failing later with an opaque signing error.
Jwt__Key=
Jwt__Issuers=
Jwt__Audience=
Jwt__ExpiryMinutes=
Jwt__RefreshExpiryMinutes=
Jwt__LongLivedRefreshExpiryDays=

# -----------------------------------------------------------------------------
# First-run seeding
# -----------------------------------------------------------------------------
# Creates one administrator when dbo.Users is empty, through IUserService so the
# first account earns a real UserRegistered audit row. Leave the password blank
# to skip seeding entirely.
Seed__AdminUsername=
Seed__AdminEmail=
Seed__AdminPassword=

# -----------------------------------------------------------------------------
# Brevo — transactional email (invitations and password resets)
# -----------------------------------------------------------------------------
# Validated at send time, not at startup: with these blank the console still
# runs, signs people in and creates accounts — only the mail fails, and it fails
# naming the key that is missing.

# Brevo dashboard -> SMTP & API -> API Keys. Starts with "xkeysib-".
Brevo__ApiKey=

# Brevo dashboard -> Campaigns -> Templates. The numeric id of each template.
# Import the HTML from docs/email/ as raw HTML ("Paste your code"), NOT into the
# drag-and-drop builder — see the header comment in each file for why.
#   docs/email/brevo-account-activation.html
Brevo__ActivationTemplateId=
#   docs/email/brevo-password-reset.html
Brevo__PasswordResetTemplateId=

# Optional. Left blank, each mail uses the sender configured on its Brevo
# template, which is usually what you want. Set both to override.
Brevo__SenderName=
Brevo__SenderEmail=

# -----------------------------------------------------------------------------
# Where the console lives — the origin the links in those mails point at
# -----------------------------------------------------------------------------
# No trailing slash. Must be reachable by whoever opens the mail, so in
# production this is the public address, not localhost.
App__ConsoleBaseUrl=https://localhost:7285

# Optional. Rendered as the Help and Privacy links in the mail footers; blank
# leaves them pointing nowhere, so set them before sending to real recipients.
App__HelpUrl=
App__PrivacyUrl=
