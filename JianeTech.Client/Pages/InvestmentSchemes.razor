@page "/manage/investment-schemes"
@attribute [Authorize(Roles = ConsoleRoles.Administrator)]
@using JianeTech.Client.Auth
@using JianeTech.Client.Auth.Models
@using JianeTech.Client.Schemes
@using JianeTech.Client.Shared
@using Microsoft.AspNetCore.Authorization
@inject FundApiClient Api
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Investment schemes · Jiane's Tech Solar Fund</PageTitle>

<header class="page-head">
    <div>
        <h1>Investment schemes</h1>
        <p class="page-head__sub">The terms capital can be placed with the fund on.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--primary" href="manage/investment-schemes/new">
            <Icon Name="plus" Size="16" />
            New scheme
        </a>
    </div>
</header>

<div class="page-body">
    <div class="filters">
        <div class="filters__search">
            <span class="filters__icon"><Icon Name="search" Size="17" /></span>
            <label class="sr-only" for="inv-search">Search the schemes</label>
            <input class="field__input"
                   id="inv-search"
                   type="search"
                   placeholder="Search by what the scheme is called"
                   value="@_search"
                   @oninput="OnSearchInput" />
        </div>

        <div class="filters__field">
            <label class="filters__label" for="inv-status">Status</label>
            <select class="field__select" id="inv-status" value="@_status" @onchange="OnStatusChange">
                <option value="">Any status</option>
                <option value="active">On offer</option>
                <option value="withdrawn">Withdrawn</option>
            </select>
        </div>

        @* The one filter here that is not a range, because it is the one thing about
           a scheme that has exactly two answers. *@
        <div class="filters__field">
            <label class="filters__label" for="inv-structure">Structure</label>
            <select class="field__select" id="inv-structure" value="@_structure" @onchange="OnStructureChange">
                <option value="">Either structure</option>
                <option value="0">Immediate</option>
                <option value="1">Deferred</option>
            </select>
        </div>

        @* Bands rather than an exact term: nobody looks for a scheme by
           remembering it ran seven years. *@
        <div class="filters__field">
            <label class="filters__label" for="inv-term">Term</label>
            <select class="field__select" id="inv-term" value="@_term" @onchange="OnTermChange">
                <option value="">Any term</option>
                <option value="short">Up to 3 years</option>
                <option value="medium">4 to 5 years</option>
                <option value="long">6 to 10 years</option>
                <option value="extended">Over 10 years</option>
            </select>
        </div>

        @if (HasFilters)
        {
            <button class="btn btn--quiet filters__clear" type="button" @onclick="ClearFiltersAsync">
                Clear filters
            </button>
        }

        @if (!_loading)
        {
            <span class="filters__count">
                @_total.ToString("N0") @(_total == 1 ? "scheme" : "schemes")
            </span>
        }
    </div>

    @if (_notice is { Length: > 0 })
    {
        <div class="alert alert--success" role="status" style="margin-bottom: var(--s-5)">
            <span class="alert__icon"><Icon Name="activity" Size="17" /></span>
            <span>@_notice</span>
            <button class="alert__dismiss" type="button" aria-label="Dismiss"
                    @onclick="() => _notice = null">
                <Icon Name="close" Size="14" />
            </button>
        </div>
    }

    @if (_error is { Length: > 0 })
    {
        <div class="alert alert--error" role="alert" style="margin-bottom: var(--s-5)">
            <span class="alert__icon"><Icon Name="alert" Size="17" /></span>
            <span>
                @_error
                <button class="btn btn--quiet" type="button" style="margin-left: var(--s-2)"
                        @onclick="() => LoadAsync(_page)">Try again</button>
            </span>
        </div>
    }

    <section class="panel">
        @if (_loading)
        {
            <div style="padding: var(--s-4) var(--s-5)">
                @for (var i = 0; i < 8; i++)
                {
                    <div class="skeleton"
                         style="height: 14px; margin: var(--s-4) 0; width: @(SkeletonWidths[i % SkeletonWidths.Length])"></div>
                }
            </div>
        }
        else if (_schemes.Count == 0)
        {
            <div class="empty">
                <p class="empty__title">@EmptyTitle</p>
                <p class="empty__body">@EmptyBody</p>
                @if (!HasFilters)
                {
                    <a class="btn btn--ghost" href="manage/investment-schemes/new"
                       style="margin-top: var(--s-2)">Set up the first scheme</a>
                }
            </div>
        }
        else
        {
            <div class="ledger-scroll">
            <table class="ledger">
                <thead>
                    <tr>
                        <th class="ledger__index" scope="col">#</th>
                        <th scope="col">Scheme</th>
                        <th class="ledger__h-structure" scope="col">Structure</th>
                        <th class="ledger__h-minimum" scope="col">Minimum</th>
                        <th scope="col">Term</th>
                        <th class="ledger__h-return" scope="col">Return</th>
                        <th scope="col">Status</th>
                        <th class="ledger__h-actions" scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (scheme, offset) in _schemes.Select((s, i) => (s, i)))
                    {
                        @* Modelled at the scheme's own minimum, which is the only placement
                           the register knows about. Everything in the Return column scales
                           with the sum actually placed except the installation, and the
                           configuration page is where that is explored. *@
                        var figures = InvestmentMath.SummariseBrief(ToTerms(scheme));

                        <tr>
                            @* Counts the whole result set, not the page, so a row
                               number means the same thing on page 3 as on page 1. *@
                            <td class="ledger__index">@(FirstOnPage + offset)</td>

                            @* The name is the link to the configuration page rather than
                               a pencil in the actions column — the same decision the
                               installment register makes, and for the same reason: a row
                               that leads somewhere should say so where the eye already is. *@
                            <td class="ledger__account">
                                <a class="ledger__link" href="manage/investment-schemes/@scheme.SchemeId">
                                    <b>@scheme.Description</b>
                                </a>
                                <span>@scheme.SchemeTypeTiming</span>
                            </td>

                            <td class="ledger__structure">
                                <b>@scheme.SchemeTypeLabel</b>
                                <span>@CapitalTiming(scheme)</span>
                            </td>

                            <td class="ledger__minimum">
                                <b>@Peso.Whole(scheme.MinimumInvestment)</b>
                                <span>
                                    @(scheme.FreeInstallationAmt > 0
                                        ? $"{Peso.Whole(scheme.FreeInstallationAmt)} installation"
                                        : "No installation")
                                </span>
                            </td>

                            <td class="ledger__horizon">
                                <b>@Peso.Years(scheme.InvestmentYears)</b>
                                <span>@TermQualifier(scheme, figures)</span>
                            </td>

                            @* The quoted rate and what it accumulates to, in that order
                               and never one without the other: a rate per annum says
                               nothing about how long it runs for, and two schemes quoting
                               the same figure over three and ten years are not the same
                               offer. The rest of the ladder is on the configuration page. *@
                            <td class="ledger__return">
                                <b>@Peso.Rate(scheme.IncomeInterest / 100m) a year</b>
                                <span>@Peso.Rate(figures.InterestShare) over the term</span>
                            </td>

                            <td class="ledger__status">
                                <span class="ledger__status-inner">
                                    <span class="dot dot--@scheme.StatusTone"></span>
                                    @scheme.Status
                                </span>
                            </td>

                            <td class="ledger__actions">
                                <div class="row-actions">
                                    <button class="icon-btn @(scheme.IsActive ? "icon-btn--danger" : "")"
                                            type="button"
                                            title="@ActionVerb(scheme) @scheme.Description"
                                            aria-label="@ActionVerb(scheme) @scheme.Description"
                                            @onclick="() => OpenConfirm(scheme)">
                                        <Icon Name="power" Size="16" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>

            <Pager Page="_page" PageSize="PageSize" Total="_total"
                   Noun="scheme" OnGo="LoadAsync" />
        }
    </section>
</div>

<ConfirmDialog Open="_confirming is not null"
               Title="@ConfirmTitle"
               ConfirmLabel="@ConfirmLabel"
               BusyLabel="@(_confirming?.IsActive == true ? "Withdrawing" : "Restoring")"
               Destructive="@(_confirming?.IsActive == true)"
               Busy="_confirmBusy"
               Error="@_confirmError"
               Note="@($"Writes an {(_confirming?.IsActive == true ? "Investment scheme withdrawn" : "Investment scheme restored")} row to the activity log.")"
               OnCancel="CloseConfirm"
               OnConfirm="ConfirmAsync">
    @if (_confirming is { } target)
    {
        @if (target.IsActive)
        {
            <p>
                <b>@target.Description</b> will no longer be offered to anyone new.
            </p>
            <p class="confirm__after">
                Nothing is deleted, and no capital already placed on these terms is
                affected — a placement keeps the figures it was made on. The scheme stays
                in this register as <b>Withdrawn</b>, and you can put it back on offer
                from here.
            </p>
        }
        else
        {
            <p>
                <b>@target.Description</b> can be offered again, on exactly the terms it
                carries now.
            </p>
            <p class="confirm__after">
                Check those terms first if it has been withdrawn a while — what the fund
                can afford to pay moves with what an installation costs, and this scheme
                still holds the profit interest it was withdrawn at.
            </p>
        }
    }
</ConfirmDialog>

@code {
    private const int PageSize = 20;

    /// <summary>Wait for a pause in typing before querying, rather than per keystroke.</summary>
    private static readonly TimeSpan SearchDebounce = TimeSpan.FromMilliseconds(320);

    /// <summary>Varied widths so the placeholder reads as text, not as bars.</summary>
    private static readonly string[] SkeletonWidths = ["64%", "81%", "52%", "74%", "59%", "86%"];

    private List<InvestmentSchemeRow> _schemes = [];
    private int _total;
    private int _page = 1;
    private bool _loading = true;
    private string? _error;
    private string? _notice;

    private InvestmentSchemeRow? _confirming;
    private bool _confirmBusy;
    private string? _confirmError;

    private string _search = string.Empty;
    private string _status = string.Empty;
    private string _structure = string.Empty;
    private string _term = string.Empty;

    private CancellationTokenSource? _debounce;

    private int FirstOnPage => (_page - 1) * PageSize + 1;

    private bool HasFilters =>
        !string.IsNullOrWhiteSpace(_search)
        || !string.IsNullOrEmpty(_status)
        || !string.IsNullOrEmpty(_structure)
        || !string.IsNullOrEmpty(_term);

    private string EmptyTitle => HasFilters
        ? "No schemes match those filters"
        : "No schemes yet";

    private string EmptyBody => HasFilters
        ? "Nothing in the register matches what is set above. Clear the filters to see every scheme."
        : "A scheme sets the least an investor may place, the profit interest it earns over the term, and when the installation they receive is fitted.";

    protected override Task OnInitializedAsync() => LoadAsync(1);

    /// <summary>
    /// The six terms the arithmetic needs, lifted off a register row and modelled at the
    /// scheme's own minimum. Every derived number this table prints is computed here
    /// rather than sent by the server — see <c>InvestmentMath</c> for why the calculation
    /// lives in one place, on this side.
    /// </summary>
    private static InvestmentTerms ToTerms(InvestmentSchemeRow scheme) => new(
        scheme.MinimumInvestment,
        (SchemeStructure)scheme.SchemeType,
        scheme.IncomeInterest,
        scheme.GracePeriodMonths,
        scheme.InvestmentYears,
        scheme.FreeInstallationAmt);

    /// <summary>
    /// What happens to the capital, which is the other half of the structure. The row
    /// already names the installation's timing under the scheme's name; this is the piece
    /// that follows from it.
    /// </summary>
    private static string CapitalTiming(InvestmentSchemeRow scheme)
        => (SchemeStructure)scheme.SchemeType == SchemeStructure.Immediate
            ? "Capital back over the tail"
            : "Capital paid down monthly";

    /// <summary>
    /// The term's second line: what lands each month, and when the first one does. A
    /// scheme with no grace period says so by saying nothing about it.
    /// </summary>
    private static string TermQualifier(InvestmentSchemeRow scheme, InvestmentFigures figures)
    {
        if (!figures.IsCoherent)
        {
            return "Terms need checking";
        }

        var monthly = $"{Peso.Whole(figures.PeriodicReturn)} a month";

        return scheme.GracePeriodMonths > 0
            ? $"{monthly} from month {figures.FirstPayoutMonth}"
            : monthly;
    }

    private static string ActionVerb(InvestmentSchemeRow scheme)
        => scheme.IsActive ? "Withdraw" : "Put back on offer";

    private string ConfirmTitle => _confirming is null
        ? string.Empty
        : _confirming.IsActive ? "Withdraw this scheme?" : "Put this scheme back on offer?";

    private string ConfirmLabel => _confirming?.IsActive == true ? "Withdraw" : "Put back on offer";

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;

        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;

        try
        {
            await Task.Delay(SearchDebounce, token);
            await LoadAsync(1);
        }
        catch (TaskCanceledException)
        {
            // Superseded by a later keystroke — the newer query owns the result.
        }
    }

    private Task OnStatusChange(ChangeEventArgs args)
    {
        _status = args.Value?.ToString() ?? string.Empty;
        return LoadAsync(1);
    }

    private Task OnStructureChange(ChangeEventArgs args)
    {
        _structure = args.Value?.ToString() ?? string.Empty;
        return LoadAsync(1);
    }

    private Task OnTermChange(ChangeEventArgs args)
    {
        _term = args.Value?.ToString() ?? string.Empty;
        return LoadAsync(1);
    }

    private Task ClearFiltersAsync()
    {
        _search = string.Empty;
        _status = string.Empty;
        _structure = string.Empty;
        _term = string.Empty;
        return LoadAsync(1);
    }

    private void OpenConfirm(InvestmentSchemeRow scheme)
    {
        _notice = null;
        _confirmError = null;
        _confirmBusy = false;
        _confirming = scheme;
    }

    private void CloseConfirm()
    {
        if (_confirmBusy) return;
        _confirming = null;
    }

    private async Task ConfirmAsync()
    {
        if (_confirming is not { } target || _confirmBusy) return;

        _confirmBusy = true;
        _confirmError = null;

        var response = await Api.SetInvestmentSchemeActiveAsync(target.SchemeId, !target.IsActive);

        _confirmBusy = false;

        if (response.Code != 200)
        {
            // Stays open with the server's sentence attached — most usefully when putting
            // a scheme back on offer collided with a newer one holding its name.
            _confirmError = response.Message;
            return;
        }

        _confirming = null;
        _notice = response.Message;

        await LoadAsync(_page);
    }

    private async Task LoadAsync(int page)
    {
        if (page < 1) return;

        _loading = true;
        _error = null;
        StateHasChanged();

        // The bands partition the register exactly as the filter labels them, so a scheme
        // the Term column calls five years cannot turn up under "6 to 10 years".
        var (minYears, maxYears) = _term switch
        {
            "short" => ((int?)null, (int?)3),
            "medium" => (4, 5),
            "long" => (6, 10),
            "extended" => (11, null),
            _ => (null, null),
        };

        var response = await Api.GetInvestmentSchemesAsync(
            page,
            PageSize,
            _search,
            _status switch { "active" => true, "withdrawn" => false, _ => null },
            string.IsNullOrEmpty(_structure) ? null : int.Parse(_structure),
            minYears,
            maxYears);

        if (response.Code == 401)
        {
            Nav.NavigateTo("login", replace: true);
            return;
        }

        if (response.Code == 200 && response.Data is not null)
        {
            _schemes = response.Data.Items;
            _total = response.Data.TotalRows;
            _page = page;
        }
        else
        {
            _error = response.Message;
            _schemes = [];
            _total = 0;
        }

        _loading = false;
    }

    public void Dispose()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
    }
}
