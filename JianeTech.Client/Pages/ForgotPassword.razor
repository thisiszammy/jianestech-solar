@page "/forgot-password"
@layout BareLayout
@using JianeTech.Client.Auth
@using JianeTech.Client.Shared
@inject FundApiClient Api

@*
    Asking for a recovery link.

    The screen after submitting is the same screen whatever happened — account
    found, account unknown, account still holding an unspent invitation, mail
    that bounced. That is the whole design of this page, not a hedge: an answer
    that varied with the account's existence would make this a way of testing
    which usernames and addresses are real, which is also why the sign-in form
    refuses a wrong password and an unknown user with one sentence. The server
    keeps the real outcome in its log.

    So the confirmation below is careful about what it claims. It does not say
    a message was sent; it says what will happen if the account is there.
*@

<PageTitle>Reset your password · Jiane's Tech Solar Fund</PageTitle>

<AccountShell Statement="Forgotten your password? That is recoverable."
              Title="@(_sent ? "Check your email" : "Reset your password")"
              Lede="@Lede">

    @if (_sent)
    {
        <div class="account__state" role="status">
            <p class="account__state-title">
                <span class="dot dot--success"></span>
                Request received
            </p>

            @* The server's own sentence, which is deliberately conditional. *@
            <p class="account__state-body">@_notice</p>

            <p class="account__state-body" style="margin-top: var(--s-3)">
                The link works for one hour and can be used once. If nothing arrives,
                check the spam folder, or ask an administrator to send one from the
                user register.
            </p>

            <div class="account__state-actions">
                <a class="btn btn--primary" href="login">Back to sign in</a>
                <button class="btn btn--ghost" type="button" @onclick="StartOver">
                    Try another address
                </button>
            </div>
        </div>
    }
    else
    {
        <form @onsubmit="SubmitAsync" @onsubmit:preventDefault>
            <div class="account__fields">
                @if (_error is { Length: > 0 })
                {
                    <div class="alert alert--error" role="alert">
                        <span class="alert__icon"><Icon Name="alert" Size="17" /></span>
                        <span>@_error</span>
                    </div>
                }

                @* One field, not two. Asking for "username or email" in a single
                   box means nobody has to remember which one their account was
                   filed under — the server accepts either. *@
                <div class="field">
                    <label class="field__label" for="identifier">Username or email</label>
                    <input class="field__input"
                           id="identifier"
                           name="identifier"
                           type="text"
                           autocomplete="username"
                           spellcheck="false"
                           autocapitalize="none"
                           disabled="@_busy"
                           @bind="_identifier"
                           @bind:event="oninput" />
                </div>

                <button class="btn btn--primary btn--block" type="submit" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="btn__spinner" aria-hidden="true"></span>
                        <span>Sending</span>
                    }
                    else
                    {
                        <span>Send the link</span>
                    }
                </button>

                <a class="account__back" href="login">Back to sign in</a>
            </div>
        </form>

        <p class="account__foot">
            Still holding an invitation you have not used? That link sets your first
            password on its own — this page is for accounts that already have one.
        </p>
    }

</AccountShell>

@code {
    private string _identifier = string.Empty;
    private bool _busy;
    private bool _sent;
    private string? _error;
    private string? _notice;

    private string Lede => _sent
        ? "Nothing else to do here."
        : "Tell us which account, and we will send a link to the address on file.";

    private async Task SubmitAsync()
    {
        if (_busy) return;

        // Caught here so an empty submit does not spend one of the five requests
        // a minute the strict limiter allows this endpoint.
        if (string.IsNullOrWhiteSpace(_identifier))
        {
            _error = "Enter your username or email address.";
            return;
        }

        _busy = true;
        _error = null;

        var response = await Api.RequestPasswordResetAsync(_identifier.Trim());

        _busy = false;

        if (response.Code == 200)
        {
            _notice = response.Message;
            _sent = true;
            return;
        }

        // Only a rate-limit or an unreachable API can land here; the endpoint
        // itself answers 200 to everything else, on purpose.
        _error = response.Message;
    }

    private void StartOver()
    {
        _sent = false;
        _notice = null;
        _error = null;
        _identifier = string.Empty;
    }
}
