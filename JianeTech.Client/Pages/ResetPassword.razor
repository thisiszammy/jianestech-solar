@page "/reset-password"
@layout BareLayout
@using JianeTech.Client.Shared

@*
    Where a recovery email lands. Same screen as Activate with different wording
    and a different pair of endpoints — both live in AccountLinkPage.
*@

<PageTitle>Choose a new password · Jiane's Tech Solar Fund</PageTitle>

<AccountLinkPage Mode="AccountLinkPage.LinkMode.Recovery" Token="@Token" />

@code {
    /// <summary>The token, as the email's RESET_URL leaves it: <c>/reset-password?t={guid}</c>.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "t")]
    public Guid? Token { get; set; }
}
