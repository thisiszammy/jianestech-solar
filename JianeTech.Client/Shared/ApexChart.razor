@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    ApexChart — one host element and its lifecycle.

    The component owns nothing about how a chart looks. It hands a kind and a
    payload to js/charts.js, which builds the option object; everything visual —
    colour, formatters, axes — lives there, because the parts of an ApexCharts
    configuration that matter most are functions, and a function cannot cross
    the interop boundary.

    aria-hidden, deliberately. What ApexCharts renders is an SVG of positioned
    paths with no reading order, and labelling it would promise a screen-reader
    user a description the element cannot deliver. Every chart in this console
    is instead published twice: once as this picture, and once as the ledger or
    the summary line beside it, which is the part that is actually readable.
    See the schedule panel on the scheme configuration page.
*@

@* min-height, not height: the figure is also passed into the chart options, so
   ApexCharts sizes the whole SVG — axis titles included — to it. Reserving the
   same number here means the panel is the right height before the module has
   even loaded, and the page does not jump when it does. *@
<div class="chart" style="min-height: @(Height)px" @ref="_host" aria-hidden="true"></div>

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;

    /// <summary>The payload currently on screen, by reference. Null until the first draw lands.</summary>
    private object? _drawn;

    /// <summary>A draw is in flight. Keystrokes arrive faster than the module loads on a cold page.</summary>
    private bool _drawing;

    private bool _disposed;

    /// <summary>
    /// Which builder in charts.js to use — one of the keys on its <c>builders</c> map:
    /// <c>payments</c>, <c>schedule</c>, <c>investmentPayout</c>, <c>investmentRecovery</c>.
    /// </summary>
    [Parameter, EditorRequired]
    public string Kind { get; set; } = string.Empty;

    /// <summary>
    /// The series and labels, as an object serialized straight to JSON. A new instance on
    /// every recompute — the reference is what tells this component the picture is stale.
    /// </summary>
    [Parameter, EditorRequired]
    public object? Data { get; set; }

    [Parameter]
    public int Height { get; set; } = 260;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _drawing || Data is null || ReferenceEquals(Data, _drawn))
        {
            return;
        }

        _drawing = true;
        var payload = Data;

        try
        {
            var module = await ModuleAsync();

            if (_disposed)
            {
                return;
            }

            // Re-optioning keeps the chart's own animation between two states, which is
            // what makes a column move to its new height as a figure is typed rather than
            // the panel blinking. Only the first draw builds an instance.
            await module.InvokeVoidAsync(
                _drawn is null ? "render" : "update", _host, Kind, payload, Height);
            _drawn = payload;
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        finally
        {
            _drawing = false;
        }

        // Typing does not wait for the draw. If a newer payload arrived while that one was
        // in flight, ask for the render that will pick it up — the guard at the top is what
        // stops this from being a loop.
        if (!_disposed && !ReferenceEquals(Data, _drawn))
        {
            StateHasChanged();
        }
    }

    private async ValueTask<IJSObjectReference> ModuleAsync()
        => _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        // ApexCharts registers window listeners for its own resize handling, so an
        // instance left behind on navigation keeps responding to a page it no longer
        // belongs to. Both calls can fail if the circuit is already gone, which is not
        // something to report.
        try
        {
            if (_module is not null)
            {
                if (_drawn is not null)
                {
                    await _module.InvokeVoidAsync("destroy", _host);
                }

                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }
}
